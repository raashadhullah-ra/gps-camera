# ==============================================================================
# LIVE PRODUCTION ENVIRONMENT CONFIGURATION (FOR RENDER & AIVEN MYSQL)
# ==============================================================================
# Copy these values into your Render Dashboard -> "Environment" tab

APP_NAME="GeoCam"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Render captures logs from stderr/stdout)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ==============================================================================
# AIVEN MYSQL DATABASE CONNECTION
# ==============================================================================
# Fill these with your Aiven MySQL Service Details
DB_CONNECTION=mysql
DB_HOST=mysql-xxxx-your-project.aivencloud.com
DB_PORT=your_aiven_port_number
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password

# SSL settings for Aiven (optional if using default system certificates)
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# ==============================================================================
# SESSION, CACHE & QUEUE
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ==============================================================================
# STORAGE & ASSETS
# ==============================================================================
FILESYSTEM_DISK=public
VITE_APP_NAME="${APP_NAME}"

# Optional: Set to 'true' in Render if you want initial seeders to run on deploy
RUN_SEEDS=false
